{
  "name": "omp-antigravity-pro",
  "version": "0.1.0",
  "description": "Oh My Pi Antigravity transport fix with native OAuth and account rotation",
  "author": "ART1KZ",
  "license": "MIT",
  "homepage": "https://github.com/ART1KZ/omp-antigravity-pro#readme",
  "bugs": {
    "url": "https://github.com/ART1KZ/omp-antigravity-pro/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ART1KZ/omp-antigravity-pro.git"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "extension",
    "google-antigravity",
    "gemini",
    "oauth"
  ],
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "docs",
    "install.ps1",
    "install.sh"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "test": "bun test",
    "check": "npm run typecheck && npm run lint && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@oh-my-pi/pi-ai": "^18.1.0",
    "@oh-my-pi/pi-catalog": "^18.1.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=17.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@oh-my-pi/pi-coding-agent": "18.1.5",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=20"
  }
}